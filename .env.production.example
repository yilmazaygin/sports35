APP_NAME=Sports35
APP_ENV=production
APP_KEY=generate-and-store-a-unique-32-byte-key-outside-source-control
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
PUBLIC_DOMAIN=example.com
# Production routes the panel by host, not by an /admin path. Use the real
# admin hostname. Nginx Proxy Manager must proxy this host to the same app.
ADMIN_DOMAIN=admin.example.com
# Trust the Docker proxy in front of PHP. Keep the app Nginx off the public
# internet (docker-compose.proxy.yml). Use a comma-separated IP list instead
# of * if the app port is ever published on the host.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sports35
DB_USERNAME=sports35
DB_PASSWORD=replace-with-a-long-random-secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Sports35"

# First admin account created by production seeding. Supply these at deployment
# time and never commit them or copy them into a public image.
SPORTS35_ADMIN_NAME=Sports35 Admin
SPORTS35_ADMIN_EMAIL=admin@example.com
SPORTS35_ADMIN_PASSWORD=replace-with-a-unique-random-password

# Standalone TLS only (docker-compose.production.yml without the proxy file).
# The Nginx Proxy Manager path does not publish these ports.
HTTP_PORT=80
HTTPS_PORT=443

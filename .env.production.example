APP_NAME=Sports35
APP_ENV=production
APP_KEY=generate-and-store-a-unique-32-byte-key-outside-source-control
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
PUBLIC_DOMAIN=example.com
# The existing application works at /admin on the public host. Add an admin
# subdomain only if the business later requires it and configure its cookie/TLS
# behavior deliberately.

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sports35
DB_USERNAME=sports35
DB_PASSWORD=replace-with-a-long-random-secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Sports35"

# Production owner bootstrap. These must be supplied at deployment time and
# must never be committed or copied into a public image.
SPORTS35_OWNER_NAME=Sports35 Owner
SPORTS35_OWNER_EMAIL=owner@example.com
SPORTS35_OWNER_PASSWORD=replace-with-a-unique-random-password

# Used by the production Compose file for host bindings.
HTTP_PORT=80
HTTPS_PORT=443

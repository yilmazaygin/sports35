FROM node:22-alpine AS frontend

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY resources ./resources
COPY public ./public
COPY vite.config.js tailwind.config.js postcss.config.js jsconfig.json ./
RUN npm run build

FROM node:22-alpine AS ssr
WORKDIR /srv
COPY --from=frontend /build/package.json /srv/package.json
COPY --from=frontend /build/bootstrap/ssr /srv/bootstrap/ssr
COPY bootstrap/ssr-listen.cjs /srv/bootstrap/ssr-listen.cjs
EXPOSE 13714
CMD ["node", "--require", "./bootstrap/ssr-listen.cjs", "bootstrap/ssr/ssr.js"]

FROM composer:2 AS dependencies

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --no-scripts \
    --optimize-autoloader

FROM php:8.4-fpm

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libpq-dev \
    zip \
    unzip \
    && docker-php-ext-install pdo pdo_pgsql pgsql mbstring exif pcntl bcmath gd \
    && pecl install redis \
    && docker-php-ext-enable redis opcache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/production.ini /usr/local/etc/php/conf.d/production.ini

RUN useradd -G www-data,root -u 1000 -d /home/sports35 sports35 \
    && mkdir -p /home/sports35/.composer /var/www/html/storage \
    && chown -R sports35:sports35 /home/sports35 /var/www/html

WORKDIR /var/www/html
COPY --chown=sports35:sports35 . .
COPY --from=dependencies --chown=sports35:sports35 /app/vendor ./vendor
COPY --from=frontend --chown=sports35:sports35 /build/public/build ./public/build

RUN mkdir -p bootstrap/cache storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && chown -R sports35:sports35 bootstrap/cache storage

USER sports35

EXPOSE 9000
CMD ["php-fpm"]
